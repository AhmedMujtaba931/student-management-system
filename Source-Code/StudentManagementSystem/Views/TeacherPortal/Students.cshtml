@model IEnumerable<StudentManagementSystem.Models.Enrollment>
@{
    ViewData["Title"] = "Course Students";
    var course = ViewBag.Course as StudentManagementSystem.Models.Course;
}
<div class="container py-4">
    <h2 class="mb-1">@course?.CourseCode — @course?.CourseName</h2>
    <p class="text-muted mb-4">Enrolled Students</p>
    <div class="card shadow-sm">
        <table class="table table-hover mb-0">
            <thead class="table-light">
                <tr><th>Reg No</th><th>Name</th><th>Email</th><th>Status</th><th>Enrolled</th></tr>
            </thead>
            <tbody>
            @foreach (var e in Model)
            {
                <tr>
                    <td>@e.Student?.RegistrationNumber</td>
                    <td>@e.Student?.FullName</td>
                    <td>@e.Student?.Email</td>
                    <td><span class="badge bg-success">@e.Status</span></td>
                    <td>@e.EnrollmentDate.ToString("dd MMM yyyy")</td>
                </tr>
            }
            </tbody>
        </table>
    </div>
    <a asp-action="Dashboard" class="btn btn-outline-secondary mt-3">Back</a>
</div>