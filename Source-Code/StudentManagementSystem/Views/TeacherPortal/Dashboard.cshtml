@using StudentManagementSystem.Models

@{
    ViewData["Title"] = "Teacher Dashboard";
    var teacher = ViewBag.Teacher as Teacher;
    var courses = ViewBag.Courses as List<Course> ?? new List<Course>();
    var totalStudents = (int)(ViewBag.TotalStudents ?? 0);
    var totalGrades = (int)(ViewBag.TotalGrades ?? 0);
}

<div class="dashboard-page">

    <div class="dashboard-header">
        <div>
            <span class="dashboard-eyebrow">TEACHER PORTAL</span>
            <h1>Welcome, @teacher?.FirstName</h1>
            <p>Manage your assigned courses and student grades.</p>
        </div>
    </div>

    <div class="row g-4 mb-4">
        <div class="col-md-6 col-xl-3">
            <div class="stat-card">
                <div class="stat-icon">ID</div>
                <div><span>Employee Code</span><strong>@teacher?.EmployeeCode</strong></div>
            </div>
        </div>
        <div class="col-md-6 col-xl-3">
            <div class="stat-card">
                <div class="stat-icon">C</div>
                <div><span>Assigned Courses</span><strong>@courses.Count</strong></div>
            </div>
        </div>
        <div class="col-md-6 col-xl-3">
            <div class="stat-card">
                <div class="stat-icon">S</div>
                <div><span>Total Students</span><strong>@totalStudents</strong></div>
            </div>
        </div>
        <div class="col-md-6 col-xl-3">
            <div class="stat-card">
                <div class="stat-icon">G</div>
                <div><span>Grades Recorded</span><strong>@totalGrades</strong></div>
            </div>
        </div>
    </div>

    <div class="row g-4">
        <div class="col-lg-5">
            <div class="dashboard-card">
                <div class="card-heading">
                    <div><h5>My Information</h5><p>Your personal faculty record.</p></div>
                </div>
                <div class="record-summary">
                    <div><span>Full Name</span><strong>@teacher?.FirstName @teacher?.LastName</strong></div>
                    <div><span>Email</span><strong>@teacher?.Email</strong></div>
                    <div><span>Department</span><strong>@teacher?.Department</strong></div>
                    <div><span>Designation</span><strong>@teacher?.Designation</strong></div>
                </div>
            </div>
        </div>

        <div class="col-lg-7">
            <div class="dashboard-card">
                <div class="card-heading d-flex justify-content-between align-items-center">
                    <div><h5>My Courses</h5><p>Courses currently assigned to you.</p></div>
                    <a asp-action="Courses" class="btn btn-sm btn-outline-dark">View All</a>
                </div>

                @if (courses.Any())
                {
                    <div class="table-responsive">
                        <table class="table align-middle mb-0">
                            <thead>
                                <tr><th>Course</th><th>Credit Hours</th><th></th></tr>
                            </thead>
                            <tbody>
                                @foreach (var course in courses)
                                {
                                    <tr>
                                        <td>
                                            <strong>@course.CourseCode</strong>
                                            <div class="text-muted small">@course.CourseName</div>
                                        </td>
                                        <td>@course.CreditHours</td>
                                        <td>
                                            <a asp-action="CourseRoster" asp-route-id="@course.CourseId" class="btn btn-sm btn-primary">View Roster</a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="empty-state">
                        <strong>No courses assigned yet</strong>
                        <p>Ask the administrator to assign a course to your account.</p>
                    </div>
                }
            </div>
        </div>
    </div>

</div>