@model IEnumerable<StudentManagementSystem.Models.Course>
@{
    ViewData["Title"] = "My Courses";
}
<div class="container py-4">
    <h2 class="mb-4">My Courses</h2>
    <div class="card shadow-sm">
        <table class="table mb-0">
            <thead class="table-light">
                <tr><th>Code</th><th>Name</th><th>Credits</th><th></th></tr>
            </thead>
            <tbody>
            @foreach (var c in Model)
            {
                <tr>
                    <td>@c.CourseCode</td>
                    <td>@c.CourseName</td>
                    <td>@c.CreditHours</td>
                    <td>
                        <a asp-action="Students" asp-route-courseId="@c.CourseId" class="btn btn-sm btn-outline-primary">Students</a>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
    <a asp-action="Dashboard" class="btn btn-outline-secondary mt-3">Back</a>
</div>