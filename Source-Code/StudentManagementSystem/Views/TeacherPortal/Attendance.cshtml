@model StudentManagementSystem.ViewModels.MarkAttendanceViewModel
@using StudentManagementSystem.Models

@{
    var course = ViewBag.Course as Course;
    ViewData["Title"] = $"Attendance - {course?.CourseCode}";
    var statuses = new[] { "Present", "Absent", "Late", "Excused" };
}

<div class="container py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="fw-bold mb-1">@course?.CourseCode &mdash; @course?.CourseName</h1>
            <p class="text-muted mb-0">Mark attendance for the selected date.</p>
        </div>
        <a asp-action="Courses" class="btn btn-outline-secondary">Back to My Courses</a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">@TempData["SuccessMessage"]</div>
    }

    <form asp-action="Attendance" method="get" class="row g-2 align-items-end mb-4">
        <input type="hidden" name="courseId" value="@Model.CourseId" />
        <div class="col-auto">
            <label class="form-label fw-semibold">Attendance Date</label>
            <input type="date" name="date" class="form-control" value="@Model.AttendanceDate.ToString("yyyy-MM-dd")" />
        </div>
        <div class="col-auto">
            <button type="submit" class="btn btn-outline-dark">Load Date</button>
        </div>
    </form>

    <div class="card shadow-sm border-0">
        <div class="card-body">

            @if (Model.Entries.Any())
            {
                <form asp-action="SaveAttendance" method="post">
                    <input type="hidden" asp-for="CourseId" />
                    <input type="hidden" asp-for="AttendanceDate" />

                    <div class="table-responsive">
                        <table class="table table-hover align-middle">
                            <thead class="table-dark">
                                <tr>
                                    <th>Registration No.</th>
                                    <th>Student Name</th>
                                    <th style="width: 220px;">Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                @for (int i = 0; i < Model.Entries.Count; i++)
                                {
                                    <tr>
                                        <td>
                                            @Model.Entries[i].RegistrationNumber
                                            <input type="hidden" asp-for="Entries[i].EnrollmentId" />
                                            <input type="hidden" asp-for="Entries[i].StudentName" />
                                            <input type="hidden" asp-for="Entries[i].RegistrationNumber" />
                                        </td>
                                        <td>@Model.Entries[i].StudentName</td>
                                        <td>
                                            <select asp-for="Entries[i].Status" class="form-select">
                                                @foreach (var status in statuses)
                                                {
                                                    <option value="@status">@status</option>
                                                }
                                            </select>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    <button type="submit" class="btn btn-primary px-4 mt-3">Save Attendance</button>
                </form>
            }
            else
            {
                <div class="text-center py-4">
                    <h5>No students enrolled in this course yet.</h5>
                    <p class="text-muted">Ask the administrator to enroll students into this course.</p>
                </div>
            }

        </div>
    </div>

</div>