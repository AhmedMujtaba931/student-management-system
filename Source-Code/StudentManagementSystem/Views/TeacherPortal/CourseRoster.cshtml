@model List<StudentManagementSystem.Models.Enrollment>
@using StudentManagementSystem.Models

@{
    var course = ViewBag.Course as Course;
    ViewData["Title"] = $"{course?.CourseCode} Roster";
    var grades = ViewBag.Grades as List<Grade> ?? new List<Grade>();
}

<div class="container py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="fw-bold mb-1">@course?.CourseCode &mdash; @course?.CourseName</h1>
            <p class="text-muted mb-0">Enrolled students and their recorded grades for this course.</p>
        </div>
        <a asp-action="Courses" class="btn btn-outline-secondary">Back to My Courses</a>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body">

            @if (Model.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle">
                        <thead class="table-dark">
                            <tr>
                                <th>Registration No.</th>
                                <th>Student Name</th>
                                <th>Recorded Grades</th>
                                <th class="text-center">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var enrollment in Model)
                            {
                                var studentGrades = grades.Where(g => g.StudentId == enrollment.StudentId).ToList();

                                <tr>
                                    <td>@enrollment.Student?.RegistrationNumber</td>
                                    <td>@enrollment.Student?.FirstName @enrollment.Student?.LastName</td>
                                    <td>
                                        @if (studentGrades.Any())
                                        {
                                            foreach (var grade in studentGrades)
                                            {
                                                <span class="badge bg-dark me-1 mb-1">@grade.AssessmentType: @grade.GradeLetter</span>
                                            }
                                        }
                                        else
                                        {
                                            <span class="text-muted small">No grades yet</span>
                                        }
                                    </td>
                                    <td class="text-center">
                                        <a asp-action="CreateGrade" asp-route-studentId="@enrollment.StudentId" asp-route-courseId="@enrollment.CourseId" class="btn btn-sm btn-primary">+ Add Grade</a>
                                        @if (studentGrades.Any())
                                        {
                                            <a asp-action="EditGrade" asp-route-id="@studentGrades.First().GradeId" class="btn btn-sm btn-warning">Edit Latest</a>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center py-4">
                    <h5>No students enrolled in this course yet.</h5>
                    <p class="text-muted">Ask the administrator to enroll students into this course.</p>
                </div>
            }

        </div>
    </div>

</div>