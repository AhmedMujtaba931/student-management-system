@model StudentManagementSystem.Models.Grade

@{
    ViewData["Title"] = "Edit Grade";
    var assessmentTypes = ViewBag.AssessmentTypes as string[] ?? Array.Empty<string>();
}

<div class="container py-4">

    <div class="mb-4">
        <h1 class="fw-bold mb-1">Edit Grade</h1>
        <p class="text-muted">Update this assessment result.</p>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-header bg-dark text-white py-3">
            <h5 class="mb-0">@Model.Student?.FirstName @Model.Student?.LastName &mdash; @Model.Course?.CourseCode</h5>
        </div>

        <div class="card-body p-4">

            <form asp-action="EditGrade" method="post">
                <input type="hidden" asp-for="GradeId" />
                <input type="hidden" asp-for="StudentId" />
                <input type="hidden" asp-for="CourseId" />
                <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Student</label>
                        <input class="form-control" value="@Model.Student?.FirstName @Model.Student?.LastName" disabled />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Course</label>
                        <input class="form-control" value="@Model.Course?.CourseCode - @Model.Course?.CourseName" disabled />
                    </div>
                    <div class="col-md-6">
                        <label asp-for="AssessmentType" class="form-label fw-semibold"></label>
                        <select asp-for="AssessmentType" class="form-select">
                            @foreach (var type in assessmentTypes)
                            {
                                <option value="@type">@type</option>
                            }
                        </select>
                        <span asp-validation-for="AssessmentType" class="text-danger"></span>
                    </div>
                    <div class="col-md-3">
                        <label asp-for="MarksObtained" class="form-label fw-semibold"></label>
                        <input asp-for="MarksObtained" class="form-control" type="number" step="0.01" min="0" />
                        <span asp-validation-for="MarksObtained" class="text-danger"></span>
                    </div>
                    <div class="col-md-3">
                        <label asp-for="TotalMarks" class="form-label fw-semibold"></label>
                        <input asp-for="TotalMarks" class="form-control" type="number" step="0.01" min="1" />
                        <span asp-validation-for="TotalMarks" class="text-danger"></span>
                    </div>
                    <div class="col-12">
                        <label asp-for="Remarks" class="form-label fw-semibold"></label>
                        <textarea asp-for="Remarks" class="form-control" rows="2"></textarea>
                        <span asp-validation-for="Remarks" class="text-danger"></span>
                    </div>
                </div>

                <hr class="my-4" />

                <div class="d-flex justify-content-between">
                    <a asp-action="CourseRoster" asp-route-id="@Model.CourseId" class="btn btn-outline-secondary">Cancel</a>
                    <button type="submit" class="btn btn-primary px-4">Save Changes</button>
                </div>
            </form>

        </div>
    </div>

</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}