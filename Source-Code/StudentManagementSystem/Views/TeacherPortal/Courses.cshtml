@model List<StudentManagementSystem.Models.Course>

@{
    ViewData["Title"] = "My Courses";
    var studentCounts = ViewBag.StudentCounts as Dictionary<int, int> ?? new Dictionary<int, int>();
}

<div class="container py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="fw-bold mb-1">My Courses</h1>
            <p class="text-muted mb-0">Courses currently assigned to you by the administrator.</p>
        </div>
        <a asp-action="Dashboard" class="btn btn-outline-secondary">Back to Dashboard</a>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body">

            @if (Model.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle">
                        <thead class="table-dark">
                            <tr>
                                <th>Course Code</th>
                                <th>Course Name</th>
                                <th>Credit Hours</th>
                                <th>Enrolled Students</th>
                                <th class="text-center">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var course in Model)
                            {
                                <tr>
                                    <td><strong>@course.CourseCode</strong></td>
                                    <td>@course.CourseName</td>
                                    <td>@course.CreditHours</td>
                                    <td>@(studentCounts.TryGetValue(course.CourseId, out var count) ? count : 0)</td>
                                    <td class="text-center">
                                        <a asp-action="CourseRoster" asp-route-id="@course.CourseId" class="btn btn-sm btn-primary">View Roster &amp; Grades</a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center py-4">
                    <h5>No courses assigned yet.</h5>
                    <p class="text-muted">Ask the administrator to assign a course to your account.</p>
                </div>
            }

        </div>
    </div>

</div>