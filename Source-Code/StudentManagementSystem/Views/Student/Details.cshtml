@model StudentManagementSystem.Models.Student

@{
    ViewData["Title"] = "Student Details";
}

<div class="container py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="fw-bold mb-1">Student Details</h1>
            <p class="text-muted mb-0">
                Complete student information.
            </p>
        </div>

        <div>
            <a asp-action="Edit"
               asp-route-id="@Model.StudentId"
               class="btn btn-primary me-2">
                Edit Student
            </a>

            <a asp-action="Index"
               class="btn btn-outline-secondary">
                Back
            </a>
        </div>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-header bg-dark text-white py-3">
            <h5 class="mb-0">
                @Model.FirstName @Model.LastName
            </h5>
        </div>

        <div class="card-body p-4">

            <div class="row g-4">

                <div class="col-md-6">
                    <small class="text-muted d-block">Registration Number</small>
                    <strong>@Model.RegistrationNumber</strong>
                </div>

                <div class="col-md-6">
                    <small class="text-muted d-block">Gender</small>
                    <strong>@Model.Gender</strong>
                </div>

                <div class="col-md-6">
                    <small class="text-muted d-block">First Name</small>
                    <strong>@Model.FirstName</strong>
                </div>

                <div class="col-md-6">
                    <small class="text-muted d-block">Last Name</small>
                    <strong>@Model.LastName</strong>
                </div>

                <div class="col-md-6">
                    <small class="text-muted d-block">Email</small>
                    <strong>@Model.Email</strong>
                </div>

                <div class="col-md-6">
                    <small class="text-muted d-block">Phone Number</small>
                    <strong>
                        @(string.IsNullOrWhiteSpace(Model.PhoneNumber)
                            ? "Not provided"
                            : Model.PhoneNumber)
                    </strong>
                </div>

                <div class="col-md-6">
                    <small class="text-muted d-block">Date of Birth</small>
                    <strong>
                        @(Model.DateOfBirth?.ToString("dd MMMM yyyy")
                            ?? "Not provided")
                    </strong>
                </div>

                <div class="col-md-6">
                    <small class="text-muted d-block">Created At</small>
                    <strong>
                        @Model.CreatedAt.ToString("dd MMMM yyyy, hh:mm tt")
                    </strong>
                </div>

                <div class="col-12">
                    <small class="text-muted d-block">Address</small>
                    <strong>
                        @(string.IsNullOrWhiteSpace(Model.Address)
                            ? "Not provided"
                            : Model.Address)
                    </strong>
                </div>

            </div>

        </div>
    </div>

</div>