@{
    ViewData["Title"] = "Add Teacher";
}
<div class="container py-4" style="max-width:520px">
    <h2 class="fw-bold mb-4">Add Teacher</h2>

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    <div class="card border-0 shadow-sm p-4">
        <p class="text-muted small">
            Pehle user ko <strong>Register</strong> se banao, phir yahan select karke Teacher role do.
        </p>
        <form asp-action="AddTeacher" method="post">
            <div class="mb-3">
                <label class="form-label">Select User</label>
                <select name="userId" class="form-select" asp-items="ViewBag.Users" required>
                    <option value="">-- Select User --</option>
                </select>
            </div>
            <button type="submit" class="btn btn-primary">Make Teacher</button>
            <a asp-action="Teachers" class="btn btn-outline-secondary">Cancel</a>
        </form>
    </div>
</div>