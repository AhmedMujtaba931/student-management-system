@{
    ViewData["Title"] = "Link Student to User";
}
<div class="container py-4" style="max-width:560px">
    <h2 class="mb-4 fw-bold">Link Student ↔ User Account</h2>
    <div class="card border-0 shadow-sm p-4">
        <form asp-action="LinkStudent" method="post">
            <div class="mb-3">
                <label class="form-label">Unlinked Student</label>
                <select name="studentId" class="form-select" asp-items="ViewBag.Students" required>
                    <option value="">-- Select Student --</option>
                </select>
            </div>
            <div class="mb-3">
                <label class="form-label">Student User Account</label>
                <select name="userId" class="form-select" asp-items="ViewBag.Users" required>
                    <option value="">-- Select User --</option>
                </select>
            </div>
            <button type="submit" class="btn btn-primary">Link Accounts</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
        </form>
    </div>
</div>