@{
    ViewData["Title"] = "Admin Dashboard";
}

<div class="container py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="fw-bold mb-1">Admin Dashboard</h1>
            <p class="text-muted mb-0">Manage students, courses, enrollments, attendance and grades.</p>
        </div>

        <form asp-controller="Account" asp-action="Logout" method="post">
            <button type="submit" class="btn btn-dark">Logout</button>
        </form>
    </div>

    <div class="row g-4">

        <div class="col-md-4">
            <div class="card h-100 shadow-sm border-0">
                <div class="card-body">
                    <h5 class="fw-bold">Students</h5>
                    <p class="text-muted">Manage student records and registration information.</p>
                    <a asp-controller="Student" asp-action="Index" class="btn btn-dark">Manage Students</a>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card h-100 shadow-sm border-0">
                <div class="card-body">
                    <h5 class="fw-bold">Teachers</h5>
                    <p class="text-muted">Manage faculty records and login accounts.</p>
                    <a asp-controller="Teacher" asp-action="Index" class="btn btn-dark">Manage Teachers</a>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card h-100 shadow-sm border-0">
                <div class="card-body">
                    <h5 class="fw-bold">Courses</h5>
                    <p class="text-muted">Manage available courses and credit hours.</p>
                    <a asp-controller="Course" asp-action="Index" class="btn btn-dark">Manage Courses</a>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card h-100 shadow-sm border-0">
                <div class="card-body">
                    <h5 class="fw-bold">Enrollments</h5>
                    <p class="text-muted">Manage student course enrollments.</p>
                    <a asp-controller="Enrollment" asp-action="Index" class="btn btn-dark">Manage Enrollments</a>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card h-100 shadow-sm border-0">
                <div class="card-body">
                    <h5 class="fw-bold">Attendance</h5>
                    <p class="text-muted">Record and review student attendance.</p>
                    <a asp-controller="Attendance" asp-action="Index" class="btn btn-dark">Manage Attendance</a>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card h-100 shadow-sm border-0">
                <div class="card-body">
                    <h5 class="fw-bold">Grades</h5>
                    <p class="text-muted">Manage academic grades and results.</p>
                    <a asp-controller="Grade" asp-action="Index" class="btn btn-dark">Manage Grades</a>
                </div>
            </div>
        </div>

    </div>
</div>