@model IEnumerable<StudentManagementSystem.Models.Course>

@{
    ViewData["Title"] = "Courses";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h2>Courses</h2>
            <p class="text-muted">Manage all courses in the system.</p>
        </div>
        <a asp-action="Create" class="btn btn-primary">+ Add Course</a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">@TempData["SuccessMessage"]</div>
    }

    <div class="card shadow-sm">
        <div class="card-body">

            @if (Model.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle">
                        <thead class="table-dark">
                            <tr>
                                <th>Course Code</th>
                                <th>Course Name</th>
                                <th>Credit Hours</th>
                                <th>Teacher</th>
                                <th>Description</th>
                                <th class="text-center">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var course in Model)
                            {
                                <tr>
                                    <td><strong>@course.CourseCode</strong></td>
                                    <td>@course.CourseName</td>
                                    <td>@course.CreditHours</td>
                                    <td>
                                        @if (course.Teacher != null)
                                        {
                                            @($"{course.Teacher.FirstName} {course.Teacher.LastName}")
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">Unassigned</span>
                                        }
                                    </td>
                                    <td>
                                        @(string.IsNullOrWhiteSpace(course.Description) ? "No description" : course.Description)
                                    </td>
                                    <td class="text-center">
                                        <a asp-action="Details" asp-route-id="@course.CourseId" class="btn btn-sm btn-info">Details</a>
                                        <a asp-action="Edit" asp-route-id="@course.CourseId" class="btn btn-sm btn-warning">Edit</a>
                                        <a asp-action="Delete" asp-route-id="@course.CourseId" class="btn btn-sm btn-danger">Delete</a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center py-4">
                    <h5>No courses found.</h5>
                    <p class="text-muted">Add your first course to get started.</p>
                </div>
            }

        </div>
    </div>

</div>