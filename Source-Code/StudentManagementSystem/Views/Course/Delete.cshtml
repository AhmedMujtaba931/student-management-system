@model StudentManagementSystem.Models.Course

@{
    ViewData["Title"] = "Delete Course";
}

<div class="container mt-4">

    <div class="mb-3">
        <h2>Delete Course</h2>
        <p class="text-muted">Review the course before deleting it.</p>
    </div>

    <div class="card shadow-sm border-danger">
        <div class="card-body">

            <div class="alert alert-warning">
                <strong>Warning:</strong>
                Are you sure you want to delete this course?
            </div>

            <dl class="row">

                <dt class="col-sm-3">
                    Course Code
                </dt>
                <dd class="col-sm-9">
                    @Model.CourseCode
                </dd>

                <dt class="col-sm-3">
                    Course Name
                </dt>
                <dd class="col-sm-9">
                    @Model.CourseName
                </dd>

                <dt class="col-sm-3">
                    Credit Hours
                </dt>
                <dd class="col-sm-9">
                    @Model.CreditHours
                </dd>

                <dt class="col-sm-3">
                    Description
                </dt>
                <dd class="col-sm-9">
                    @(string.IsNullOrWhiteSpace(Model.Description)
                        ? "No description provided."
                        : Model.Description)
                </dd>

            </dl>

            <form asp-action="Delete" method="post">

                <input type="hidden"
                       asp-for="CourseId" />

                <div class="d-flex gap-2">

                    <button type="submit"
                            class="btn btn-danger">
                        Delete Course
                    </button>

                    <a asp-action="Index"
                       class="btn btn-secondary">
                        Cancel
                    </a>

                </div>

            </form>

        </div>
    </div>

</div>