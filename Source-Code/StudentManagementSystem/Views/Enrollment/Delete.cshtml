@model StudentManagementSystem.Models.Enrollment

@{
    ViewData["Title"] = "Delete Enrollment";
}

<div class="container mt-4">

    <div class="mb-3">
        <h2>Delete Enrollment</h2>
        <p class="text-muted">
            Review the enrollment before deleting it.
        </p>
    </div>

    <div class="card shadow-sm border-danger">
        <div class="card-body">

            <div class="alert alert-warning">
                <strong>Warning:</strong>
                Are you sure you want to delete this enrollment?
            </div>

            <dl class="row">

                <dt class="col-sm-3">
                    Student
                </dt>

                <dd class="col-sm-9">
                    <strong>
                        @Model.Student?.RegistrationNumber
                    </strong>
                    -
                    @Model.Student?.FirstName
                    @Model.Student?.LastName
                </dd>

                <dt class="col-sm-3">
                    Course
                </dt>

                <dd class="col-sm-9">
                    <strong>
                        @Model.Course?.CourseCode
                    </strong>
                    -
                    @Model.Course?.CourseName
                </dd>

                <dt class="col-sm-3">
                    Enrollment Date
                </dt>

                <dd class="col-sm-9">
                    @Model.EnrollmentDate.ToString("dd MMM yyyy")
                </dd>

                <dt class="col-sm-3">
                    Status
                </dt>

                <dd class="col-sm-9">
                    @Model.Status
                </dd>

            </dl>

            <form asp-action="Delete" method="post">

                <input type="hidden"
                       asp-for="EnrollmentId" />

                <div class="d-flex gap-2">

                    <button type="submit"
                            class="btn btn-danger">
                        Delete Enrollment
                    </button>

                    <a asp-action="Index"
                       class="btn btn-secondary">
                        Cancel
                    </a>

                </div>

            </form>

        </div>
    </div>

</div>