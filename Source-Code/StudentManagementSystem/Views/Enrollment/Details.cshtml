@model StudentManagementSystem.Models.Enrollment

@{
    ViewData["Title"] = "Enrollment Details";
}

<div class="container mt-4">

    <div class="mb-3">
        <h2>Enrollment Details</h2>
        <p class="text-muted">
            View complete enrollment information.
        </p>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">

            <dl class="row">

                <dt class="col-sm-3">
                    Student
                </dt>

                <dd class="col-sm-9">
                    <strong>
                        @Model.Student?.RegistrationNumber
                    </strong>
                    -
                    @Model.Student?.FirstName
                    @Model.Student?.LastName
                </dd>

                <dt class="col-sm-3">
                    Course
                </dt>

                <dd class="col-sm-9">
                    <strong>
                        @Model.Course?.CourseCode
                    </strong>
                    -
                    @Model.Course?.CourseName
                </dd>

                <dt class="col-sm-3">
                    Enrollment Date
                </dt>

                <dd class="col-sm-9">
                    @Model.EnrollmentDate.ToString("dd MMM yyyy")
                </dd>

                <dt class="col-sm-3">
                    Status
                </dt>

                <dd class="col-sm-9">
                    @Model.Status
                </dd>

            </dl>

            <div class="d-flex gap-2 mt-3">

                <a asp-action="Edit"
                   asp-route-id="@Model.EnrollmentId"
                   class="btn btn-warning">
                    Edit
                </a>

                <a asp-action="Index"
                   class="btn btn-secondary">
                    Back to Enrollments
                </a>

            </div>

        </div>
    </div>

</div>