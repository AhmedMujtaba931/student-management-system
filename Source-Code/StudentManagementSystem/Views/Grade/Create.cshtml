@model StudentManagementSystem.Models.Grade

@{
    ViewData["Title"] = "Add Grade";
    var assessmentTypes = ViewBag.AssessmentTypes as string[] ?? Array.Empty<string>();
}

<div class="container mt-4">

    <div class="mb-3">
        <h2>Add Grade</h2>
        <p class="text-muted">Record a new assessment result for a student.</p>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">

            <form asp-action="Create" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="row g-3">
                    <div class="col-md-6">
                        <label asp-for="StudentId" class="form-label">Student</label>
                        <select asp-for="StudentId" asp-items="ViewBag.Students" class="form-select">
                            <option value="">-- Select Student --</option>
                        </select>
                        <span asp-validation-for="StudentId" class="text-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="CourseId" class="form-label">Course</label>
                        <select asp-for="CourseId" asp-items="ViewBag.Courses" class="form-select">
                            <option value="">-- Select Course --</option>
                        </select>
                        <span asp-validation-for="CourseId" class="text-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="AssessmentType" class="form-label"></label>
                        <select asp-for="AssessmentType" class="form-select">
                            <option value="">-- Select Assessment Type --</option>
                            @foreach (var type in assessmentTypes)
                            {
                                <option value="@type">@type</option>
                            }
                        </select>
                        <span asp-validation-for="AssessmentType" class="text-danger"></span>
                    </div>

                    <div class="col-md-3">
                        <label asp-for="MarksObtained" class="form-label"></label>
                        <input asp-for="MarksObtained" class="form-control" type="number" step="0.01" min="0" />
                        <span asp-validation-for="MarksObtained" class="text-danger"></span>
                    </div>

                    <div class="col-md-3">
                        <label asp-for="TotalMarks" class="form-label"></label>
                        <input asp-for="TotalMarks" class="form-control" type="number" step="0.01" min="1" value="100" />
                        <span asp-validation-for="TotalMarks" class="text-danger"></span>
                    </div>

                    <div class="col-12">
                        <label asp-for="Remarks" class="form-label"></label>
                        <textarea asp-for="Remarks" class="form-control" rows="3" placeholder="Optional remarks"></textarea>
                        <span asp-validation-for="Remarks" class="text-danger"></span>
                    </div>
                </div>

                <div class="d-flex gap-2 mt-3">
                    <button type="submit" class="btn btn-primary">Add Grade</button>
                    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
                </div>
            </form>

        </div>
    </div>

</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}