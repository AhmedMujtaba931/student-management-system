@{
    ViewData["Title"] = "Home";
}

<div class="container py-5">
    <div class="row align-items-center min-vh-50">
        <div class="col-lg-7">
            <p class="text-primary fw-semibold mb-2">STUDENT MANAGEMENT SYSTEM</p>
            <h1 class="display-5 fw-bold mb-3">Manage students, courses, attendance & grades</h1>
            <p class="lead text-muted mb-4">
                A centralized system for administrators, teachers and students.
                Secure role-based access for every user.
            </p>
            <div class="d-flex gap-2">
                <a asp-controller="Account" asp-action="Login" class="btn btn-primary btn-lg px-4">
                    Login
                </a>
                <a asp-controller="Account" asp-action="Register" class="btn btn-outline-primary btn-lg px-4">
                    Register
                </a>
            </div>
        </div>
        <div class="col-lg-5 mt-4 mt-lg-0">
            <div class="card border-0 shadow-sm">
                <div class="card-body p-4">
                    <h5 class="fw-bold mb-3">Quick access</h5>
                    <ul class="list-unstyled mb-0">
                        <li class="mb-2">• Admin — full system control</li>
                        <li class="mb-2">• Teacher — grades & attendance</li>
                        <li class="mb-2">• Student — courses, grades, profile</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>