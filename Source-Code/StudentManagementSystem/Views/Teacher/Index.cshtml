@model IEnumerable<StudentManagementSystem.Models.Teacher>

@{
    ViewData["Title"] = "Teachers";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h2>Teachers</h2>
            <p class="text-muted">Manage faculty records and login accounts.</p>
        </div>
        <a asp-action="Create" class="btn btn-primary">+ Add Teacher</a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">@TempData["SuccessMessage"]</div>
    }

    <div class="card shadow-sm">
        <div class="card-body">

            @if (Model.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle">
                        <thead class="table-dark">
                            <tr>
                                <th>Employee Code</th>
                                <th>Name</th>
                                <th>Department</th>
                                <th>Designation</th>
                                <th>Email</th>
                                <th class="text-center">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var teacher in Model)
                            {
                                <tr>
                                    <td><strong>@teacher.EmployeeCode</strong></td>
                                    <td>@teacher.FirstName @teacher.LastName</td>
                                    <td>@teacher.Department</td>
                                    <td>@teacher.Designation</td>
                                    <td>@teacher.Email</td>
                                    <td class="text-center">
                                        <a asp-action="Details" asp-route-id="@teacher.TeacherId" class="btn btn-sm btn-info">Details</a>
                                        <a asp-action="Edit" asp-route-id="@teacher.TeacherId" class="btn btn-sm btn-warning">Edit</a>
                                        <a asp-action="Delete" asp-route-id="@teacher.TeacherId" class="btn btn-sm btn-danger">Delete</a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center py-4">
                    <h5>No teachers found.</h5>
                    <p class="text-muted">Add your first teacher to get started.</p>
                </div>
            }

        </div>
    </div>

</div>