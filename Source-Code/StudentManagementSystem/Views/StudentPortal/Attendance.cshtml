@model List<StudentManagementSystem.Models.AttendanceRecord>

@{
    ViewData["Title"] = "My Attendance";
    var presentCount = Model.Count(a => a.Status == "Present");
    var attendancePercentage = Model.Count > 0 ? Math.Round((double)presentCount / Model.Count * 100, 1) : 0;
}

<div class="container py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="fw-bold mb-1">My Attendance</h1>
            <p class="text-muted mb-0">Attendance history across all your enrolled courses.</p>
        </div>
        <a asp-action="Dashboard" class="btn btn-outline-secondary">Back to Dashboard</a>
    </div>

    <div class="row g-4 mb-4">
        <div class="col-md-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="text-muted small">Total Sessions</div>
                    <div class="fs-3 fw-bold">@Model.Count</div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="text-muted small">Present</div>
                    <div class="fs-3 fw-bold text-success">@presentCount</div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="text-muted small">Attendance Rate</div>
                    <div class="fs-3 fw-bold">@attendancePercentage%</div>
                </div>
            </div>
        </div>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body">

            @if (Model.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle">
                        <thead class="table-dark"><tr><th>Course</th><th>Date</th><th>Status</th></tr></thead>
                        <tbody>
                            @foreach (var record in Model)
                            {
                                var badgeClass = record.Status switch
                                {
                                    "Present" => "bg-success",
                                    "Late" => "bg-warning text-dark",
                                    "Excused" => "bg-info text-dark",
                                    _ => "bg-danger"
                                };

                                <tr>
                                    <td>
                                        <strong>@record.Enrollment?.Course?.CourseCode</strong>
                                        <div class="text-muted small">@record.Enrollment?.Course?.CourseName</div>
                                    </td>
                                    <td>@record.AttendanceDate.ToString("dd MMM yyyy")</td>
                                    <td><span class="badge @badgeClass">@record.Status</span></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center py-4">
                    <h5>No attendance records found.</h5>
                    <p class="text-muted">Attendance will appear here once it is recorded by the administrator.</p>
                </div>
            }

        </div>
    </div>

</div>