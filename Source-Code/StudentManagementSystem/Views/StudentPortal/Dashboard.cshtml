@using StudentManagementSystem.Models

@{
    ViewData["Title"] = "My Dashboard";
    var student = ViewBag.Student as Student;
    var enrollments = ViewBag.Enrollments as List<Enrollment> ?? new List<Enrollment>();
    var attendance = ViewBag.Attendance as List<AttendanceRecord> ?? new List<AttendanceRecord>();
    var grades = ViewBag.Grades as List<Grade> ?? new List<Grade>();

    var presentCount = attendance.Count(a => a.Status == "Present");
    var attendancePercentage = attendance.Count > 0
        ? Math.Round((double)presentCount / attendance.Count * 100, 1)
        : 0;

    var averagePercentage = grades.Count > 0
        ? Math.Round(grades.Average(g => g.TotalMarks > 0 ? (double)(g.MarksObtained / g.TotalMarks) * 100 : 0), 1)
        : 0;
}

<div class="dashboard-page">

    <div class="dashboard-header">
        <div>
            <span class="dashboard-eyebrow">STUDENT PORTAL</span>
            <h1>Welcome, @student?.FirstName</h1>
            <p>View your personal academic information and enrollments.</p>
        </div>
    </div>

    <div class="row g-4 mb-4">
        <div class="col-md-6 col-xl-3">
            <div class="stat-card">
                <div class="stat-icon">ID</div>
                <div><span>Registration No.</span><strong>@student?.RegistrationNumber</strong></div>
            </div>
        </div>
        <div class="col-md-6 col-xl-3">
            <div class="stat-card">
                <div class="stat-icon">C</div>
                <div><span>Enrolled Courses</span><strong>@enrollments.Count</strong></div>
            </div>
        </div>
        <div class="col-md-6 col-xl-3">
            <div class="stat-card">
                <div class="stat-icon">E</div>
                <div><span>Email</span><strong class="small">@student?.Email</strong></div>
            </div>
        </div>
        <div class="col-md-6 col-xl-3">
            <div class="stat-card">
                <div class="stat-icon">A</div>
                <div><span>Attendance</span><strong>@attendancePercentage%</strong></div>
            </div>
        </div>
        <div class="col-md-6 col-xl-3">
            <div class="stat-card">
                <div class="stat-icon">G</div>
                <div><span>Average Score</span><strong>@(grades.Count > 0 ? $"{averagePercentage}%" : "N/A")</strong></div>
            </div>
        </div>
    </div>

    <div class="row g-4">
        <div class="col-lg-5">
            <div class="dashboard-card">
                <div class="card-heading">
                    <div><h5>My Information</h5><p>Your personal student record.</p></div>
                </div>
                <div class="record-summary">
                    <div><span>Full Name</span><strong>@student?.FirstName @student?.LastName</strong></div>
                    <div><span>Email</span><strong>@student?.Email</strong></div>
                    <div><span>Phone</span><strong>@(student?.PhoneNumber ?? "Not provided")</strong></div>
                    <div><span>Gender</span><strong>@student?.Gender</strong></div>
                </div>
            </div>
        </div>

        <div class="col-lg-7">
            <div class="dashboard-card">
                <div class="card-heading">
                    <div><h5>My Courses</h5><p>Courses currently associated with your account.</p></div>
                </div>

                @if (enrollments.Any())
                {
                    <div class="table-responsive">
                        <table class="table align-middle mb-0">
                            <thead><tr><th>Course</th><th>Enrollment Date</th><th>Status</th></tr></thead>
                            <tbody>
                                @foreach (var enrollment in enrollments)
                                {
                                    <tr>
                                        <td>
                                            <strong>@enrollment.Course?.CourseCode</strong>
                                            <div class="text-muted small">@enrollment.Course?.CourseName</div>
                                        </td>
                                        <td>@enrollment.EnrollmentDate.ToString("dd MMM yyyy")</td>
                                        <td><span class="badge bg-success">@enrollment.Status</span></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="empty-state">
                        <strong>No courses found</strong>
                        <p>No course enrollment has been assigned to your account yet.</p>
                    </div>
                }
            </div>
        </div>
    </div>

    <div class="row g-4 mt-1">
        <div class="col-12">
            <div class="dashboard-card">
                <div class="card-heading d-flex justify-content-between align-items-center">
                    <div><h5>My Grades</h5><p>Latest recorded assessment results.</p></div>
                    <a asp-action="Grades" class="btn btn-sm btn-outline-dark">View All</a>
                </div>

                @if (grades.Any())
                {
                    <div class="table-responsive">
                        <table class="table align-middle mb-0">
                            <thead><tr><th>Course</th><th>Assessment</th><th>Marks</th><th>Percentage</th><th>Grade</th></tr></thead>
                            <tbody>
                                @foreach (var grade in grades.Take(5))
                                {
                                    var percentage = grade.TotalMarks > 0
                                        ? Math.Round((double)(grade.MarksObtained / grade.TotalMarks) * 100, 1)
                                        : 0;

                                    <tr>
                                        <td><strong>@grade.Course?.CourseCode</strong></td>
                                        <td>@grade.AssessmentType</td>
                                        <td>@grade.MarksObtained / @grade.TotalMarks</td>
                                        <td>@percentage%</td>
                                        <td><span class="badge bg-dark">@(grade.GradeLetter ?? "-")</span></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="empty-state">
                        <strong>No grades yet</strong>
                        <p>Your teacher has not recorded any grades for you yet.</p>
                    </div>
                }
            </div>
        </div>
    </div>

</div>