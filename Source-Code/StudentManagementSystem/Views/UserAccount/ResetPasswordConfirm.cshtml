@{
    ViewData["Title"] = "Reset Password";
}

<div class="container py-4">

    <div class="mb-4">
        <h1 class="fw-bold mb-1">Reset Password</h1>
        <p class="text-muted">Confirm to generate a new temporary password for this account.</p>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-header bg-warning py-3">
            <h5 class="mb-0">Confirm Reset</h5>
        </div>

        <div class="card-body p-4">

            <div class="alert alert-info">
                A new random password will be generated and shown once.
                Share it securely with the user, they should sign in and
                can then change it if they wish.
            </div>

            <div class="row g-3 mb-4">
                <div class="col-md-6">
                    <small class="text-muted d-block">Full Name</small>
                    <strong>@ViewBag.FullName</strong>
                </div>
                <div class="col-md-6">
                    <small class="text-muted d-block">Email</small>
                    <strong>@ViewBag.Email</strong>
                </div>
                <div class="col-md-6">
                    <small class="text-muted d-block">Role</small>
                    <strong>@ViewBag.Role</strong>
                </div>
            </div>

            <form asp-action="ResetPassword" asp-route-id="@ViewBag.UserId" method="post">
                <div class="d-flex justify-content-between">
                    <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                    <button type="submit" class="btn btn-warning px-4">Generate New Password</button>
                </div>
            </form>

        </div>
    </div>

</div>