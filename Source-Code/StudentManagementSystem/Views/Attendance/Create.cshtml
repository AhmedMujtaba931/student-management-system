@model StudentManagementSystem.Models.AttendanceSession

@{
    ViewData["Title"] = "Create Lecture";
}

<div class="dashboard-page">

    <div class="mb-4">
        <span class="dashboard-eyebrow">ATTENDANCE</span>
        <h1 class="fw-bold">Create Lecture</h1>
        <p class="text-muted">
            Enter the lecture information before taking attendance.
        </p>
    </div>

    <div class="dashboard-card">

        <form asp-action="Create" method="post">

            <div asp-validation-summary="ModelOnly"
                 class="text-danger mb-3"></div>

            <div class="row g-3">

                <div class="col-md-6">
                    <label asp-for="CourseId"
                           class="form-label fw-semibold">
                        Course
                    </label>

                    <select asp-for="CourseId"
                            asp-items="ViewBag.Courses"
                            class="form-select">
                        <option value="">
                            -- Select Course --
                        </option>
                    </select>

                    <span asp-validation-for="CourseId"
                          class="text-danger"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="LectureDate"
                           class="form-label fw-semibold">
                        Lecture Date
                    </label>

                    <input asp-for="LectureDate"
                           type="date"
                           class="form-control" />

                    <span asp-validation-for="LectureDate"
                          class="text-danger"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="StartTime"
                           class="form-label fw-semibold">
                        Start Time
                    </label>

                    <input asp-for="StartTime"
                           type="time"
                           class="form-control" />

                    <span asp-validation-for="StartTime"
                          class="text-danger"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="EndTime"
                           class="form-label fw-semibold">
                        End Time
                    </label>

                    <input asp-for="EndTime"
                           type="time"
                           class="form-control" />

                    <span asp-validation-for="EndTime"
                          class="text-danger"></span>
                </div>

                <div class="col-12">
                    <label asp-for="Topic"
                           class="form-label fw-semibold">
                        Lecture Topic / What Was Covered
                    </label>

                    <textarea asp-for="Topic"
                              class="form-control"
                              rows="4"
                              placeholder="e.g. Introduction to database normalization and 1NF..."></textarea>

                    <span asp-validation-for="Topic"
                          class="text-danger"></span>
                </div>

            </div>

            <div class="d-flex gap-2 mt-4">

                <button type="submit"
                        class="btn btn-primary">
                    Continue to Attendance
                </button>

                <a asp-action="Index"
                   class="btn btn-outline-secondary">
                    Cancel
                </a>

            </div>

        </form>

    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}