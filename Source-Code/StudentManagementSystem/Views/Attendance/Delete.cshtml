@model StudentManagementSystem.Models.AttendanceRecord

@{
    ViewData["Title"] = "Delete Attendance";
}

<div class="row justify-content-center">
    <div class="col-md-7">

        <div class="card shadow-sm border-danger">
            <div class="card-body p-4">

                <h2 class="fw-bold text-danger mb-3">
                    Delete Attendance
                </h2>

                <p>
                    Are you sure you want to delete this attendance record?
                </p>

                <dl class="row">

                    <dt class="col-sm-4">Student</dt>
                    <dd class="col-sm-8">
                        @Model.Enrollment?.Student?.FirstName
                        @Model.Enrollment?.Student?.LastName
                    </dd>

                    <dt class="col-sm-4">Course</dt>
                    <dd class="col-sm-8">
                        @Model.Enrollment?.Course?.CourseCode
                    </dd>

                    <dt class="col-sm-4">Date</dt>
                    <dd class="col-sm-8">
                        @Model.AttendanceDate.ToString("dd MMM yyyy")
                    </dd>

                    <dt class="col-sm-4">Status</dt>
                    <dd class="col-sm-8">
                        @Model.Status
                    </dd>

                </dl>

                <form asp-action="Delete" method="post">

                    <input type="hidden"
                           asp-for="AttendanceRecordId" />

                    <button type="submit"
                            class="btn btn-danger">
                        Delete Attendance
                    </button>

                    <a asp-action="Index"
                       class="btn btn-outline-secondary">
                        Cancel
                    </a>

                </form>

            </div>
        </div>

    </div>
</div>