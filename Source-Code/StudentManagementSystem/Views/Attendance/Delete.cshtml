@model StudentManagementSystem.Models.AttendanceSession

@{
    ViewData["Title"] = "Delete Lecture";
}

<div class="dashboard-page">

    <div class="mb-4">
        <span class="dashboard-eyebrow">ATTENDANCE</span>
        <h1 class="fw-bold">Delete Lecture</h1>
    </div>

    <div class="dashboard-card">

        <div class="alert alert-warning">
            Deleting this lecture will also remove its
            student attendance records.
        </div>

        <dl class="row">

            <dt class="col-sm-3">Lecture</dt>
            <dd class="col-sm-9">
                Lecture #@Model.LectureNumber
            </dd>

            <dt class="col-sm-3">Course</dt>
            <dd class="col-sm-9">
                @Model.Course?.CourseCode -
                @Model.Course?.CourseName
            </dd>

            <dt class="col-sm-3">Date</dt>
            <dd class="col-sm-9">
                @Model.LectureDate.ToString("dd MMM yyyy")
            </dd>

            <dt class="col-sm-3">Topic</dt>
            <dd class="col-sm-9">
                @Model.Topic
            </dd>

            <dt class="col-sm-3">Attendance Records</dt>
            <dd class="col-sm-9">
                @Model.AttendanceRecords.Count
            </dd>

        </dl>

        <form asp-action="Delete" method="post">

            <input type="hidden"
                   asp-for="AttendanceSessionId" />

            <div class="d-flex gap-2 mt-4">

                <button type="submit"
                        class="btn btn-danger">
                    Delete Lecture
                </button>

                <a asp-action="Index"
                   class="btn btn-outline-secondary">
                    Cancel
                </a>
            </div>

        </form>
    </div>
</div>