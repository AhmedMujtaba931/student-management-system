@model IEnumerable<StudentManagementSystem.Models.AttendanceSession>

@{
    ViewData["Title"] = "Attendance";
}

<div class="dashboard-page">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <span class="dashboard-eyebrow">ACADEMIC MANAGEMENT</span>
            <h1 class="fw-bold mb-1">Attendance</h1>
            <p class="text-muted mb-0">
                Manage lectures and student attendance records.
            </p>
        </div>

        <a asp-action="Create" class="btn btn-primary">
            + Take Attendance
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">
            @TempData["SuccessMessage"]
        </div>
    }

    <div class="dashboard-card">

        @if (!Model.Any())
        {
            <div class="text-center py-5">
                <h5>No attendance sessions yet</h5>
                <p class="text-muted">
                    Create your first lecture attendance session.
                </p>

                <a asp-action="Create" class="btn btn-primary">
                    Create Lecture
                </a>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table align-middle">

                    <thead>
                        <tr>
                            <th>Lecture</th>
                            <th>Course</th>
                            <th>Date</th>
                            <th>Topic</th>
                            <th>Attendance</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var item in Model)
                        {
                            var total = item.AttendanceRecords.Count;
                            var present = item.AttendanceRecords.Count(
                                x => x.Status == "Present");

                            var percentage = total > 0
                                ? Math.Round(
                                    (double)present / total * 100, 0)
                                : 0;

                            <tr>
                                <td>
                                    <strong>
                                        Lecture #@item.LectureNumber
                                    </strong>
                                </td>

                                <td>
                                    <strong>
                                        @item.Course?.CourseCode
                                    </strong>
                                    <br />
                                    <small class="text-muted">
                                        @item.Course?.CourseName
                                    </small>
                                </td>

                                <td>
                                    @item.LectureDate.ToString("dd MMM yyyy")
                                    <br />
                                    <small class="text-muted">
                                        @item.StartTime.ToString(@"hh\:mm")
                                        -
                                        @item.EndTime.ToString(@"hh\:mm")
                                    </small>
                                </td>

                                <td>
                                    @item.Topic
                                </td>

                                <td>
                                    <strong>@percentage%</strong>
                                    <br />
                                    <small class="text-muted">
                                        @present / @total present
                                    </small>
                                </td>

                                <td class="text-end">
                                    <a asp-action="Details"
                                       asp-route-id="@item.AttendanceSessionId"
                                       class="btn btn-sm btn-outline-info">
                                        Details
                                    </a>

                                    <a asp-action="Edit"
                                       asp-route-id="@item.AttendanceSessionId"
                                       class="btn btn-sm btn-outline-primary">
                                        Edit
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>

                </table>
            </div>
        }

    </div>
</div>